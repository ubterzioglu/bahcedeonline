# Supabase public credentials (safe to expose — RLS enforces authorization)
# These are injected at build time via Vite's VITE_ prefix.
# Set the SAME values as build-args in Coolify / Docker.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"
